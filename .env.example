# Create at https://e2b.dev/dashboard
E2B_API_KEY=

# Short-lived token from the Box Developer Console (demo use only)
BOX_ACCESS_TOKEN=
BOX_FOLDER_ID=

# Optional: assign a Box review task on the generated file
BOX_REVIEWER_USER_ID=

# Optional: when blank or omitted, the demo uses Box AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Optional when private/ contains exactly one .tar.gz or .tgz archive
# BOX_MOUNT_ARCHIVE=./private/your-box-mount-build.tar.gz

# Optional compute provider; e2b is the default
SANDBOX_PROVIDER=e2b
# Vercel only: use all three values below, or VERCEL_OIDC_TOKEN
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Vercel only: Gateway takes precedence over the direct OpenAI key
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5.5
