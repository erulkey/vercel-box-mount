SANDBOX_PROVIDER=vercel

# Vercel project credentials; alternatively use VERCEL_OIDC_TOKEN
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Reviewer through Vercel AI Gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5.5

# Box document sync; use a dedicated empty folder
BOX_ACCESS_TOKEN=
BOX_FOLDER_ID=
BOX_MOUNT_ARCHIVE=/absolute/path/box-mount-0.5.0-linux-x86_64.tar.gz

# Keep reviewer assignment disabled
BOX_REVIEWER_USER_ID=
